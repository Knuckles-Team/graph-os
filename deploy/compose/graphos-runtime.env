# Internal runtime wiring for the unified topology (the engine runs as a
# child process inside the graph-os container). These values are not
# operator-tunable, so they are tracked here rather than repeated inline in
# compose.yaml. deploy/swarm/stack.yml keeps its own literal copy of this
# same set: Docker Swarm's `docker stack deploy` does not read `env_file`.
ENABLE_WEB_UI=true
GRAPH_OS_WEBUI_PORT=8080
GRAPH_SERVICE_ENDPOINTS=
GRAPH_SERVICE_PERSIST_DIR=/var/lib/graph-os/engine
ENGINE_LIFECYCLE=persistent
KG_DAEMON_ROLE=host
HOME=/var/lib/graph-os/home
XDG_CONFIG_HOME=/var/lib/graph-os/config
XDG_DATA_HOME=/var/lib/graph-os/data
XDG_STATE_HOME=/var/lib/graph-os/state
XDG_CACHE_HOME=/tmp/cache
XDG_RUNTIME_DIR=/run/epistemic-graph
