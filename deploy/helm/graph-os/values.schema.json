{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topology",
    "runtimeSecret",
    "identity",
    "policy",
    "secrets",
    "graphos",
    "daemon",
    "engine",
    "service"
  ],
  "properties": {
    "topology": {
      "type": "string",
      "enum": [
        "unified-in-process",
        "out-of-process-shared"
      ]
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "serviceAccount": {
      "$ref": "#/$defs/serviceAccount"
    },
    "rbac": {
      "type": "object",
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "enableServiceLinks": {
      "type": "boolean"
    },
    "runtimeSecret": {
      "type": "object",
      "required": [
        "name",
        "optional"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "mode",
        "issuer",
        "tenant",
        "noneExposeAck",
        "noneHostname"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "local",
            "external"
          ]
        },
        "issuer": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "noneExposeAck": {
          "type": "string"
        },
        "noneHostname": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "eunomia"
      ],
      "properties": {
        "eunomia": {
          "type": "object",
          "required": [
            "type",
            "policyFile",
            "remoteUrl"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "",
                "none",
                "embedded",
                "remote"
              ]
            },
            "policyFile": {
              "type": "string"
            },
            "remoteUrl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "required": [
        "backend",
        "vaultUrl"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "engine",
            "vault"
          ]
        },
        "vaultUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": [
        "otlpEndpoint",
        "rumOtlpMetricsEndpoint"
      ],
      "properties": {
        "otlpEndpoint": {
          "type": "string"
        },
        "rumOtlpMetricsEndpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "required": [
        "prometheusUrl"
      ],
      "properties": {
        "prometheusUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "graphos": {
      "$ref": "#/$defs/graphos"
    },
    "daemon": {
      "$ref": "#/$defs/daemon"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port",
        "webUiPort"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "webUiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "$ref": "#/$defs/ingress"
    },
    "autoscaling": {
      "$ref": "#/$defs/autoscaling"
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": [
        "enabled",
        "minAvailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingressFrom",
        "egress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "egress": {
          "type": "object",
          "required": [
            "extra"
          ],
          "properties": {
            "extra": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-fA-F0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "optionalImage": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-fA-F0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": [
        "size",
        "storageClass",
        "accessModes"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "create",
        "name",
        "annotations"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "graphos": {
      "type": "object",
      "required": [
        "image",
        "replicas",
        "port",
        "webUi",
        "webUiPort",
        "args",
        "probeHostHeader",
        "config",
        "resources",
        "persistence"
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "webUi": {
          "type": "boolean"
        },
        "webUiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "probeHostHeader": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "daemon": {
      "type": "object",
      "required": [
        "enabled",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "required": [
        "placement",
        "image",
        "replicas",
        "port",
        "tcp",
        "tls",
        "config",
        "persistence",
        "resources"
      ],
      "properties": {
        "placement": {
          "type": "string",
          "enum": [
            "sidecar",
            "child"
          ]
        },
        "image": {
          "$ref": "#/$defs/optionalImage"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tcp": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "required": [
            "secretName"
          ],
          "properties": {
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "persistence": {
          "$ref": "#/$defs/persistence"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "annotations",
        "api",
        "webUi",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "api": {
          "type": "object",
          "required": [
            "host",
            "path"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "webUi": {
          "type": "object",
          "required": [
            "host",
            "path"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "secretName"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "required": [
        "name",
        "image",
        "port"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "secretName": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
