#!/usr/bin/env python3
"""Run the GraphOS workspace-venv reconciler when the venv is broken.

The reconciler is stdlib-only.  Loading its files without ``graph_os.__init__``
keeps this command usable when an installed GraphOS dependency is missing.
"""

from __future__ import annotations

import importlib.util
import os
import sys
import types
from pathlib import Path

_CHECKOUT = Path(__file__).resolve().parents[1]


def _load_standalone() -> object:
    for name, directory in (
        ("graph_os", _CHECKOUT / "graph_os"),
        ("graph_os.deployment", _CHECKOUT / "graph_os" / "deployment"),
    ):
        if name not in sys.modules:
            package = types.ModuleType(name)
            package.__path__ = [str(directory)]  # type: ignore[attr-defined]
            sys.modules[name] = package

    target = _CHECKOUT / "graph_os" / "deployment" / "venv_sync.py"
    spec = importlib.util.spec_from_file_location(
        "graph_os.deployment.venv_sync", target
    )
    if spec is None or spec.loader is None:
        raise ImportError(f"could not load GraphOS reconciler from {target}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if str(_CHECKOUT) not in sys.path:
        sys.path.insert(0, str(_CHECKOUT))
    try:
        from graph_os.deployment.venv_sync import main as venv_main
    except ImportError:
        venv_main = _load_standalone().main  # type: ignore[attr-defined]
    return venv_main(args)


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    raise SystemExit(main())
