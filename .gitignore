# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv*/
.python-version

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# `kiss check` writes a self-calibrating .kissconfig the first time it runs
# with no --config — forbidden anywhere in the tree (check_root_hygiene.py's
# FORBIDDEN_ANYWHERE), never track it even if one appears locally.
.kissconfig
# `kiss check` also writes a .kiss/ working-cache directory. Only the
# HAND-AUTHORED .kiss/kiss.toml is tracked (it is the gate's thresholds, not
# a baseline); every other file under .kiss/ is a regenerated analysis cache.
.kiss/*
!.kiss/kiss.toml

# Native scanner reports/scratch this repo's own gate scripts may write
# under a temp dir, never here — listed defensively in case one lands.
*.kissconfig

# uv
.uv-workspace-siblings/

# Docs build output (published via GitHub Pages CI, not committed)
site/

# Editors / OS
.DS_Store
*.swp

# Fleet-shared entries required by the gitignore-convergence hook
dist-*/
target-*/
.venv/
.pytest_tmp/
node_modules/
reports/
scratch/
sdist/
target/
